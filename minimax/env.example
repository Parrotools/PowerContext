# sddctx 配置示例(占位值;复制为环境变量后按需修改,勿提交真实凭据)
#
# 用法:
#   export $(grep -v '^#' env.example | xargs)   # 或逐条 export
#   .venv/bin/sddctx doctor                      # 检查配置就绪情况

# ── MiniMax(仅 sddctx dev 需要;其余命令可不配置)──────────────────
# API Key:开放平台 platform.minimaxi.com 控制台「接口密钥」创建
SDDCTX_MINIMAX_API_KEY=请替换为你的MiniMax API Key

# 接入点:国内平台(默认)https://api.minimaxi.com/v1 ;国际平台 https://api.minimax.io/v1
#SDDCTX_MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# 模型:默认 MiniMax-M3.1-Flash;旧型号会随平台下线,以 GET /v1/models 为准
#SDDCTX_MINIMAX_MODEL=MiniMax-M3.1-Flash

# ── PowerContext Server(默认本机回环,通常无需修改)─────────────────
#SDDCTX_POWERCONTEXT_URL=http://127.0.0.1:8000
#SDDCTX_POWERCONTEXT_TOKEN=

# ── seekdb(默认嵌入实例,数据在 .sddctx-data/seekdb,通常无需修改)────
#SDDCTX_SEEKDB_PATH=
