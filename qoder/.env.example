# SeekDB D0 Cloud (optional — not needed for Docker deployment)
SEEKDB_D0_HOST=https://d0.seekdb.com
SEEKDB_D0_API_KEY=
SEEKDB_DATABASE=zhixu_learning

# PowerContext (auto-configured in Docker)
POWERCONTEXT_URL=http://127.0.0.1:8010
POWERCONTEXT_SCOPE_ID=zhixu-default

# LLM (optional — chat works in demo mode without API key)
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# CORS (for frontend deployment)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
